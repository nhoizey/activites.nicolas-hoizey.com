{
	"name": "activites.nicolas-hoizey.com",
	"version": "1.0.0",
	"title": "Les activités de Nicolas Hoizey",
	"description": "un site pour partager des activités sportives",
	"homepage": "https://activites.nicolas-hoizey.com",
	"author": {
		"name": "Nicolas Hoizey",
		"url": "https://nicolas-hoizey.com/",
		"email": "nicolas@hoizey.com"
	},
	"keywords": [
		"eleventy",
		"starter",
		"template",
		"eleventy-website",
		"eleventy-sample"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nhoizey/pack11ty.git"
	},
	"bugs": {
		"url": "https://github.com/nhoizey/pack11ty/issues"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"clean": "rimraf _site",
		"build:eleventy": "eleventy",
		"watch:eleventy": "eleventy --serve",
		"index": "npx -y pagefind --site _site",
		"start": "npm-run-all --sequential clean watch:eleventy",
		"start:debug": "DEBUG=Eleventy* npm start",
		"build": "npm-run-all --sequential clean build:eleventy index",
		"build:debug": "DEBUG=Eleventy* npm run build",
		"lint": "npx @biomejs/biome check --write",
		"benchmark": "DEBUG=Eleventy:Benchmark* npm run build >benchmark.log 2>&1",
		"bookmarklet": "bookmarklet --demo _bookmarklets/strava2md.js src/static/strava2md.html",
		"deploy": "rsync -azh --info=progress2 --stats ./_site/ nhoizey@ssh-nhoizey.alwaysdata.net:/home/nhoizey/www/activites.nicolas-hoizey.com/",
		"profile:cpu": "npx --node-options=\"--cpu-prof\" @11ty/eleventy --quiet",
		"profile:memory": "npx --node-options=\"--inspect\" @11ty/eleventy --quiet",
		"map": "./_scripts/generate-map-images.js",
		"opengraph": "./_scripts/generate-opengraph-images.js"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.5",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-plugin-directory-output": "^1.0.2",
		"@biomejs/biome": "^2.4.13",
		"@jlengstorf/get-share-image": "^1.0.2",
		"@mapbox/togeojson": "^0.16.2",
		"@turf/turf": "^7.3.5",
		"bookmarklet": "^3.0.0",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"eleventy-plugin-pack11ty": "^2.6.1",
		"esbuild": "^0.25.12",
		"exifr": "^7.1.3",
		"fast-glob": "^3.3.3",
		"image-size": "^2.0.2",
		"lodash-es": "^4.18.1",
		"lucide-static": "^0.542.0",
		"mapbox-gl": "^3.22.0",
		"mapbox-gl-style-switcher": "^1.0.11",
		"npm-run-all": "^4.1.5",
		"pagefind": "^1.5.2",
		"puppeteer-cluster": "^0.24.0",
		"puppeteer-core": "^24.29.0",
		"rimraf": "^6.1.3",
		"sanitize-html": "^2.17.3",
		"simple-icons": "^15.22.0",
		"utf8": "^3.0.0",
		"xmldom": "^0.6.0",
		"yargs": "^18.0.0",
		"zod": "^4.3.6",
		"zod-validation-error": "^4.0.2"
	},
	"dependencies": {
		"@observablehq/plot": "^0.6.17"
	}
}
