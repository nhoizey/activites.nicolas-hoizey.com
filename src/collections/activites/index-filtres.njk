---
layout: pages
title: "Activités"
pagination:
  data: collections.type_families
  size: 1
  alias: type_families_item
  addAllPagesToCollections: false
permalink: "/activites/{{ type_families_item | slugify }}/"
eleventyComputed:
  title: "Activités {{ type_families_item }}"
---

{%- css "critical" %}{% renderFile "src/assets/sass/components/filters.scss" %}{% endcss %}

{# TODO: use buttons for accessibility #}
<div class="filtres">
  <ul aria-label="Filtres par type d'activité">
    <li><a href="/activites/">toutes</a></li>
    {% for typeFamiliesItem in collections.type_families %}
        <li><a href="/activites/{{ typeFamiliesItem | slugify }}/" {% if typeFamiliesItem == type_families_item %} aria-current="true"{% endif %}>{% inline_icon typeFamiliesItem %} {{ typeFamiliesItem | safe }}</a></li>
    {% endfor %}
  </ul>
</div>

{%- css "critical" %}{% renderFile "src/assets/sass/components/card.scss" %}{% endcss %}
{% from "macros/card.njk" import card %}

<div class="activites cards">
  {% for entry in collections.activites | type_family(type_families_item) %}
    {{ card(type=entry.data.type, title=entry.data.title, url=entry.url, date=entry.data.date, distance=entry.data.distance, duration=entry.data.duration, elevation=entry.data.elevation, score=entry.data.score, where="list", map=entry.data.map, image_index=loop.index, env=build.env) }}
  {% endfor %}
</div>
