{% extends "./base.njk" %}

{% block bodyclasses %}activite{% endblock %}

{% from "macros/card.njk" import card %}

{% block content %}
  {%- css "critical" %}{% renderFile "src/assets/sass/activite.scss" %}{% endcss %}
  {%- css "critical" %}{% renderFile "src/assets/sass/components/card.scss" %}{% endcss %}

  {{ card(type, title, url, date, distance, duration, "page") }}
  <section class="description">
    {{ content | safe }}

    {% if strava or komoot %}
    <aside class="links">
      <p>Vous pouvez retrouver cette activité sur {% if strava %}{% inline_icon 'strava' %}&nbsp;<a href="{{ strava }}">Strava</a>{% endif %}{% if strava and komoot %} et {% endif %}{% if komoot %} {% inline_icon 'komoot' %}&nbsp;<a href="{{ komoot }}">Komoot</a>{% endif %}.</p>
    </aside>
    {% endif %}
  </section>
  {% set trace = page.data.trace %}

  {% if trace %}
    <section class="trace">
      <div id="map"></div>
      <noscript>
        <p>JavaScript doit être activé pour voir cette carte.</p>
      </noscript>
      <script>
      window.trace = {{ trace | safe }};
      </script>
    </section>

    <script type="module" src="{% getBundleFileUrl "js", "activite" %}"></script>
    {%- js "activite" %}{% renderFile "src/assets/js/activite.js" %}{% endjs %}
  {% endif %}

  {% set photos = page.data.photos %}
  {% set photosNumber = photos | length %}

  {% if photosNumber > 0 %}
    <h2 class="photos-title">Photos</h2>
    <section class="photos">
      <ul>
        {% for photo in photos %}
          <li>
            <figure{% if photo.geo %} data-longitude="{{ photo.geo.longitude }}" data-latitude="{{ photo.geo.latitude }}"{% endif %}>
              <a href="{{ photo.src }}" target="_blank"><img src="{{ photo.src }}" alt="{{ photo.description }}" sizes="27rem" /></a>
              <figcaption>
                <time class="dt-published" datetime="{{ photo.date }}" data-pagefind-sort="date[datetime]">{{ photo.readableTime }}</time>
                {{ ":" if photo.title }}
                {{ photo.title }}
              </figcaption>
            </figure>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

{% endblock %}
