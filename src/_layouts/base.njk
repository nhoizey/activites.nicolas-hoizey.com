<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="text-scale" content="scale" />

    {% block title %}
      {% if page.url == '/' %}
        {% set page_title %}{{ pkg.title }}, {{ pkg.description }}{% endset %}
      {% else %}
        {% set page_title %}{{ title }} — {{ pkg.title }}{% endset %}
      {% endif %}
      <title>{{ page_title }}</title>
      <meta property="og:title" content="{{ page_title }}" />
    {% endblock %}

    <link rel="preconnect" href="https://res.cloudinary.com" />

    {% include "css.njk" %}
    {% include "js.njk" %}

    {% block description %}
      <meta name="description" content="{{ description or content | excerpt | striptags }}" />
      <meta property="og:description" content="{{ description or content | excerpt | striptags }}" />
    {% endblock %}

    <link rel="canonical" href="{{ pkg.homepage + page.url }}" itemprop="url" />
    <meta property="og:url" content="{{ pkg.homepage + page.url }}" />

    {% if page.layout != "pages" %}
      <meta property="og:type" content="article" />
      <meta property="article:published_time" content="{{ page.date | attributeDate }}" />
      {% for tag in tags %}
        <meta property="article:tag" content="{{ tag }}" />
      {% endfor %}
    {% endif %}

    {# webmentions with webmention.io #}
    <link rel="webmention" href="https://webmention.io/activites.nicolas-hoizey.com/webmention" />
    <link rel="pingback" href="https://webmention.io/activites.nicolas-hoizey.com/xmlrpc" />

    <link rel="alternate" type="application/rss+xml" title="Dernières activités sportives de Nicolas Hoizey" href="/flux/activites.xml" />
    <link rel="alternate" type="application/rss+xml" title="Derniers récits d'activités sportives de Nicolas Hoizey" href="/flux/recits.xml" />
    <link rel="alternate" type="application/rss+xml" title="Derniers articles de blog du site d'activités sportives de Nicolas Hoizey" href="/flux/blog.xml" />
    <link rel="icon" type="image/jpeg" href="/images/logo-192px.png" />

    {# ########################################################
    # opengraph
    # ########################################################}
    <meta property="og:site_name" content="{{ pkg.title }}" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="article:author" content="Nicolas Hoizey" />
    {#
    https://developers.facebook.com/docs/sharing/best-practices?locale=fr_FR#images
    https://developers.facebook.com/tools/debug/sharing/
    #}
    {% block opengraph %}
      <meta property="og:type" content="website">
      <meta property="article:published_time" content="2026-08-01T09:00:00+02:00">
    {% endblock %}
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {% block opengraphimage %}
      <meta property="og:image" content="/images/opengraph.jpg" />
    {% endblock %}

    {# iOS features #}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="apple-touch-icon" href="/images/logo-192px.png" />
    <meta name="apple-mobile-web-app-title" content="{{ pkg.title }}" />
    {# https://timkadlec.com/remembers/2018-06-06-web-watch/ #}
    <meta name="disabled-adaptations" content="watch" />

    {#
    Theme color: https://developers.google.com/web/updates/2014/11/Support-for-theme-color-in-Chrome-39-for-Android
    #}
    <meta name="theme-color" content="#224a4b">

    {# web app manifest #}
    {# crossorigin: https://twitter.com/TimVereecke/status/1225547620791341062 #}
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />

    {# Eleventy generator: https://www.11ty.dev/docs/data-eleventy-supplied/#use-with-meta-namegenerator #}
    <meta name="generator" content="{{ eleventy.generator }}">

    {# Mastodon: https://blog.joinmastodon.org/2024/07/highlighting-journalism-on-mastodon/ #}
    <meta name="fediverse:creator" content="@nhoizey@mamot.fr" />

    {% block morehead %}{% endblock %}

    {%- js "critical" %}
    (function (window) {
      // API key for Mapbox
      window.MAPBOX_ACCESS_TOKEN = '{{ env.MAPBOX_ACCESS_TOKEN }}';
    })(window);
    {% endjs %}
  </head>

  <body class="{% block bodyclasses %}{% endblock %}">
    <header role="banner">
      {% if page.url == '/' %}
        <h1 class="sitelogo">{{ pkg.title }}</h1>
      {% else %}
        <p class="sitelogo"><a href="/">{{ pkg.title }}</a></p>
      {% endif %}
    </header>
    {% include "components/navigation.njk" %}
    <main role="main">
      {% block content %}
        {{ content | safe }}
      {% endblock %}
    </main>
    {% include "components/footer.njk" %}
    <div style="display: none" aria-hidden="true" class="reusable-icons">
      {% inline_icon 'date' %}
      {% inline_icon 'distance' %}
      {% inline_icon 'duration' %}
      {% for type in collections.types %}
        {% inline_icon type %}
      {% endfor %}
    </div>
  </body>
</html>
