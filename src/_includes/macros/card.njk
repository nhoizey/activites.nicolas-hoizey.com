{% macro card(type, title, url, date, distance=0, duration=0, score="", where="page", map=false, image_index=false, env=false) %}
  <div class="card" style="view-transition-name: {{ url | slugify }}">
    <div class="card__content">
      {%- if type != "blog" and type != "recits" -%}
      <div class="type">
        <svg class="typeIcon" aria-hidden="true" viewBox="0 0 24 24"><use xlink:href="#{{- type | slugify -}}-icon" /></svg>
        <span class="label"{%- if where=="page" -%} data-pagefind-filter="Type d'activité"{%- endif -%}>{{ type }}</span>
      </div>
      {%- endif -%}
      {%- if where=="page" -%}
        <h1 data-pagefind-body>{{ title }}</h1>
      {%- else -%}
        <h3><a href="{{ url }}">{{ title }}</a></h3>
      {%- endif -%}
      <ul class="meta">
        <li class="date">
          <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><use xlink:href="#date-icon" /></svg>
          <time class="dt-published" datetime="{{- date | isoDate -}}" data-pagefind-sort="date[datetime]" data-pagefind-meta="date">{{- date | readableDate -}}</time>
        </li>
        {%- if distance and distance != 0 -%}
          <li class="distance">
            {%- inline_icon 'distance' -%}
            <span>{{- distance -}}&nbsp;km</span>
          </li>
        {%- endif -%}
        {%- if duration and duration != 0 -%}
          <li class="duration">
            {%- inline_icon 'duration' -%}
            <span>{{- duration -}}</span>
          </li>
        {%- endif -%}
        {%- if score and score != "" -%}
          <li class="score">
            {%- inline_icon 'score' -%}
            <span>{{- score | scoreToHtml | safe -}}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
    {%- if map -%}
      <div class="card__map">
        <img
          {% if env and env == 'build' %}
            src="https://res.cloudinary.com/nho/image/fetch/q_auto,f_auto/c_limit,w_320/https://activites.nicolas-hoizey.com{{ url }}map.jpeg"
          {% else %}
            src="{{ url }}map.jpeg"
          {% endif %}
          eleventy:ignore
          alt="Carte de l'activité {{ title | escape }}"
          {% if image_index == 1 %}
            fetchpriority="high"
            loading="eager"
          {% endif %}
          {% if image_index > 6 %}
            loading="lazy"
          {% endif %}
        />
      </div>
    {%- endif -%}
  </div>
{% endmacro %}
