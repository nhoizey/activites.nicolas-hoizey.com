{% macro card(type, title, url, date, distance=0, duration=0, where="page", map=false) %}
  <div class="card" style="view-transition-name: {{ url | slugify }}">
    <div class="card__content">
      {%- if type != "blog" and type != "recits" -%}
      <div class="type">
        <svg class="typeIcon" aria-hidden="true" viewBox="0 0 24 24"><use xlink:href="#{{- type | slugify -}}-icon" /></svg>
        <span class="label">{{ type }}</span>
      </div>
      {%- endif -%}
      {%- if where=="page" -%}
        <h1>{{ title }}</h1>
      {%- else -%}
        <h3><a href="{{ url }}">{{ title }}</a></h3>
      {%- endif -%}
      <ul class="meta">
        <li class="date">
          <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><use xlink:href="#date-icon" /></svg>
          <time class="dt-published" datetime="{{- date | isoDate -}}" data-pagefind-sort="date[datetime]">{{- date | readableDate -}}</time>
        </li>
        {%- if distance != 0 -%}
          <li class="distance">
            {%- inline_icon 'distance' -%}
            <span>{{- distance -}}&nbsp;km</span>
          </li>
        {%- endif -%}
        {%- if duration != 0 -%}
          <li class="duration">
            {%- inline_icon 'duration' -%}
            <span>{{- duration -}}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
    {%- if map -%}
      <div class="card__map">
        <img src="{{ url }}map.png" alt="Carte de l'activité {{ title | escape }}" eleventy:ignore>
      </div>
    {%- endif -%}
  </div>
{% endmacro %}
